    {
      "name": "1 Auth",
      "description": "Log in as the three seeded demo accounts. Tokens are stored in collection variables and last 60 minutes.",
      "item": [
        {
          "name": "Login as Ada (EMPLOYEE)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@skillbridge.local\",\n  \"password\": \"{{demoPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Login requests use No Auth on purpose: a stale token must never be sent to the login endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code < 300) { pm.collectionVariables.set('employeeToken', pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
